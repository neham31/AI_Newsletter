{
  "functions": {
    "src/app/api/ingest/process-emails/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/digest/send/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/ingest/rss/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/ops/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/test-digest/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/ingest/process-emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/ingest/rss",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/digest/send?frequency=daily",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/digest/send?frequency=weekly",
      "schedule": "30 2 * * 1"
    }
  ]
}
