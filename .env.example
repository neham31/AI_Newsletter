# ============================================
# AI News Aggregator - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control!

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key for server-side operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Resend Email Configuration
# ============================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
# From email address for sending emails (must be verified in Resend)
FROM_EMAIL=AI Digest <noreply@yourdomain.com>

# ============================================
# Anthropic (Claude AI) Configuration
# ============================================
# Get your API key from https://console.anthropic.com/settings/keys
# Used for extracting articles from newsletter HTML
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ============================================
# Mailgun Configuration
# ============================================
# Used for receiving inbound newsletter emails
# Get from Mailgun dashboard > Sending > Domain settings > API Security
MAILGUN_SIGNING_KEY=your-mailgun-signing-key

# ============================================
# Cron Job Security
# ============================================
# A secret key to secure cron job endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ============================================
# Upstash Redis Configuration (Rate Limiting)
# ============================================
# Optional: Used for rate limiting the subscribe endpoint
# Get from https://console.upstash.com
# If not configured, rate limiting will be disabled
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# Application Configuration
# ============================================
# The base URL of your application (used for email links)
# Use http://localhost:3000 for local development
NEXT_PUBLIC_APP_URL=https://yourdomain.com
